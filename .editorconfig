root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,groovy,gradle,kt,kts}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,html,css,scss,proto}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
