# ==============================================================================
# STRATA Environment Configuration (.env.example)
# Safe development placeholders only. Do not commit real secrets or production credentials.
# ==============================================================================

# Environment mode: development | staging | production
NODE_ENV=development
STRATA_ENV=development

# ------------------------------------------------------------------------------
# Service Layer (Fastify + TypeScript)
# ------------------------------------------------------------------------------
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0
SERVICE_LOG_LEVEL=info

# Service Authentication & Authorization
API_KEY_SALT=dev_salt_replace_with_32_byte_hex_in_production
JWT_SECRET=dev_jwt_secret_replace_with_secure_random_string_in_production
JWT_EXPIRATION_HOURS=24

# Service Metadata Store (MongoDB)
MONGODB_URI=mongodb://root:example@localhost:27017/strata?authSource=admin
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Engine gRPC Connection (Service -> Java Vector Engine)
ENGINE_GRPC_HOST=127.0.0.1
ENGINE_GRPC_PORT=50051
ENGINE_GRPC_USE_TLS=false
# Internal trusted pre-shared authentication token transmitted via gRPC metadata
ENGINE_GRPC_INTERNAL_AUTH_TOKEN=dev_internal_grpc_secret_change_in_production

# ------------------------------------------------------------------------------
# Java Vector Engine (Off-Heap & Storage Configuration)
# ------------------------------------------------------------------------------
STRATA_ENGINE_PORT=50051
STRATA_ENGINE_DATA_DIR=./data
STRATA_ENGINE_WAL_DIR=./data/wal
STRATA_ENGINE_SEGMENTS_DIR=./data/segments
STRATA_ENGINE_MAX_OFFHEAP_MEMORY_MB=8192
STRATA_ENGINE_VECTOR_API_ENABLED=true
STRATA_ENGINE_SCALAR_FALLBACK=true

# ------------------------------------------------------------------------------
# Console (React 19 + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ENABLE_BENCHMARK_LAB=true
VITE_ENABLE_3D_EXPLORER=true

# ------------------------------------------------------------------------------
# Observability (Prometheus & OpenTelemetry)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=strata-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
